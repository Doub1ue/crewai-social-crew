# Copy this file to .env and fill in ONE model key. Never commit .env.

# --- AI model (pick one provider) ---
# Free tier: Google Gemini
GOOGLE_API_KEY=
# Free tier: Groq
GROQ_API_KEY=
# Paid options:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Model name in LiteLLM format. Defaults below match the free tiers:
#   Gemini: gemini/gemini-2.0-flash
#   Groq:   groq/llama-3.3-70b-versatile
#   OpenAI: openai/gpt-4o-mini
MODEL_NAME=gemini/gemini-2.0-flash

# --- Publishing (later — only needed for src/publish.py --confirm) ---
# Meta Graph API: a Facebook Page access token and the Page ID.
META_PAGE_ID=
META_ACCESS_TOKEN=
